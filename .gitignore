# ============================================================================
# .gitignore for COBOL/z/OS Development Repository
# ============================================================================

# ----------------------------------------------------------------------------
# z/OS Build Artifacts
# ----------------------------------------------------------------------------
# Compiled outputs that should not be version controlled
*.DBRMLIB/
*.LOAD/
*.OBJECT/
*.lst
*.adt
*.obj
*.mod
*.dbrm
*.loadlib
*.objlib

# ----------------------------------------------------------------------------
# DBB (Dependency Based Build) Outputs
# ----------------------------------------------------------------------------
# Build reports and logs generated by IBM Dependency Based Build
BuildReport.json
BuildReport.html
**/logs/
**/outputs/
build-outputs/
dbb-logs/
*.buildlog

# ----------------------------------------------------------------------------
# IDE & Editor Configuration Files
# ----------------------------------------------------------------------------
# VSCode
.vscode/
*.code-workspace

# DB2 Developer Extension
.db2devextconfig.json
*.db2project

# Eclipse
.project
.classpath
.settings/
.metadata/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*~
.*.swp
.*.swo

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ----------------------------------------------------------------------------
# Operating System Files
# ----------------------------------------------------------------------------
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.fuse_hidden*

# ----------------------------------------------------------------------------
# Temporary & Cache Files
# ----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.cache
*.log
*.pid
*.seed
*.pid.lock

# ----------------------------------------------------------------------------
# Build & Dependency Management
# ----------------------------------------------------------------------------
# Gradle
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Node.js (if used for tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ----------------------------------------------------------------------------
# Security & Credentials
# ----------------------------------------------------------------------------
# Never commit sensitive files
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
.env
.env.local
.env.*.local
credentials.properties
secrets.properties
**/secrets/
**/credentials/

# ----------------------------------------------------------------------------
# Documentation Build Outputs
# ----------------------------------------------------------------------------
docs/_build/
docs/.doctrees/
*.pdf
*.epub

# ----------------------------------------------------------------------------
# Test & Coverage Reports
# ----------------------------------------------------------------------------
coverage/
*.coverage
.nyc_output/
htmlcov/
.pytest_cache/
junit.xml
test-results/

# ----------------------------------------------------------------------------
# Archive & Compressed Files
# ----------------------------------------------------------------------------
# Typically these are generated and should not be committed
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.bz2

# ----------------------------------------------------------------------------
# z/OS Specific Patterns
# ----------------------------------------------------------------------------
# JCL output and spool files
*.jcl.out
*.spool
*.jesmsglg
*.jesjcl
*.jesysmsg

# ISPF temporary files
*.ispf
*.spf*

# ----------------------------------------------------------------------------
# Project-Specific Exceptions
# ----------------------------------------------------------------------------
# Keep Z-GIT directory (contains z/OS Git integration metadata)
!Z-GIT/
!Z-GIT/**

# Keep application configuration templates
!application-conf/
!application-conf/**/*.properties
!application-conf/**/*.md

# Keep source and copybook directories
!SOURCE/
!SOURCE/**
!COPYLIB/
!COPYLIB/**
!SQL/
!SQL/**

# ----------------------------------------------------------------------------
# Miscellaneous
# ----------------------------------------------------------------------------
# Lock files
*.lock
!package-lock.json

# Core dumps
core
core.*

# Compiled Python files (if Python tooling is used)
__pycache__/
*.py[cod]
*$py.class
*.so

# Java class files (if Java tooling is used)
*.class
*.jar
!gradle-wrapper.jar

# Made with Bob
